@model ControleFinanceiroWeb.Models.ViewModels.TransactionsViewModel

@{
    ViewData["Title"] = "Extrato Detalhado";
    
    string statementType = Model.StatementTypeName;

    int statementTypeId = Model.StatementTypeId;
}

<div id="transactionsContainer" class="sticky-header-container" data-statement-type-id="@statementTypeId">
    @* Selected Statement Account Banner (Styled in Premium Forest Green) *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center p-4 rounded-4 mb-3 shadow-sm border-0 text-white" style="background: linear-gradient(135deg, #0f5132 0%, #1b5e20 100%);">
        <div class="d-flex align-items-center gap-3">
            <div class="p-3 rounded-3 bg-white text-success shadow-sm d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                <i class="bi @(statementTypeId == 0 ? "bi-file-earmark-text" : "bi-credit-card") fs-3 text-success"></i>
            </div>
          
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h3 class="fw-bolder text-white mb-0">@statementType</h3>
                </div>
            
                <small class="text-white-50">Movimentação diária completa de créditos e débitos</small>
            </div>
        </div>

        <div class="mt-3 mt-md-0 d-flex gap-2">
            @if (statementTypeId > 0)
            {
                <button class="btn btn-outline-light btn-sm" id="btnRenameStatementType" data-statement-id="@statementTypeId" data-statement-name="@statementType">
                    <i class="bi bi-gear me-1"></i> Configurar Conta
                </button>
            }
        </div>
    </div>
 
    @* Date Filter Bar and Action Buttons *@
    <div class="filter-bar d-flex flex-column align-items-center gap-3 shadow-sm py-3">
        @* Row 1: Dates & Consultar *@
        <div class="d-flex flex-wrap align-items-center justify-content-center gap-3 w-100">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-calendar-range text-success fs-5"></i>
                <span class="fw-bold fs-6 text-dark">Período do Extrato:</span>
            </div>
            
            <div class="d-flex align-items-center gap-2">
                <label class="text-muted small fw-semibold">Data Inicial:</label>
                <input type="date" class="form-control form-control-dark py-1 px-2.5" id="startDate" value="@Model.Period.StartText">
            </div>
            
            <div class="d-flex align-items-center gap-2">
                <label class="text-muted small fw-semibold">Data Final:</label>
                <input type="date" class="form-control form-control-dark py-1 px-2.5" id="endDate" value="@Model.Period.EndText">
            </div>
 
            <button class="btn btn-sm btn-emerald ms-1" onclick="filterPeriod()">
                <i class="bi bi-search me-1"></i> Consultar
            </button>
        </div>
 
        @* Row 2: Action Buttons *@
        <div class="d-flex flex-wrap align-items-center justify-content-center gap-2 w-100 border-top pt-3 border-light">
            <button class="btn btn-sm btn-emerald d-flex align-items-center gap-2 fw-bold" onclick="openTransactionModal(0)">
                <i class="bi bi-plus-lg me-2"></i> Incluir Movimento
            </button>
           
            <button class="btn btn-sm btn-outline-custom d-flex align-items-center gap-2" onclick="openImportModal()">
                <i class="bi bi-file-earmark-arrow-up text-success me-2"></i> Importar Planilha
            </button>
            
            <button class="btn btn-sm btn-outline-custom d-flex align-items-center gap-2" onclick="identifyStatementItems()">
                <i class="bi bi-tags-fill text-warning me-2"></i> Identificar Itens
            </button>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Card 1: Créditos -->
    <div class="col-12 col-md-4">
        <div class="card-glass p-4 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="text-muted fw-semibold d-block mb-1" style="font-size: 0.8rem;">(+) CRÉDITOS NO PERÍODO</span>
                    <h3 class="fw-bolder mb-0 text-success" style="font-size: 1.8rem; letter-spacing: -0.5px;">@Model.TotalCredits.ToString("C")</h3>
                </div>

                <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="background-color: #e6f4ea; width: 42px; height: 42px;">
                    <i class="bi bi-arrow-down-left text-success fs-4"></i>
                </div>
            </div>

            <div class="text-muted fs-7 pt-2 border-top border-light">
                <span>Total de entradas na conta</span>
            </div>
        </div>
    </div>

    <!-- Card 2: Débitos -->
    <div class="col-12 col-md-4">
        <div class="card-glass p-4 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="text-muted fw-semibold d-block mb-1" style="font-size: 0.8rem;">(-) DÉBITOS NO PERÍODO</span>
                    <h3 class="fw-bolder mb-0 text-danger" style="font-size: 1.8rem; letter-spacing: -0.5px;">@Model.TotalDebits.ToString("C")</h3>
                </div>

                <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="background-color: #fce8e6; width: 42px; height: 42px;">
                    <i class="bi bi-arrow-up-right text-danger fs-4"></i>
                </div>
            </div>

            <div class="text-muted fs-7 pt-2 border-top border-light">
                <span>Total de saídas na conta</span>
            </div>
        </div>
    </div>

    <!-- Card 3: Saldo Final -->
    <div class="col-12 col-md-4">
        <div class="card-glass p-4 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="text-muted fw-semibold d-block mb-1" style="font-size: 0.8rem;">(=) SALDO FINAL ATUAL</span>
                    <h3 class="fw-bolder mb-0 @(Model.FinalBalance >= 0 ? "text-success" : "text-danger")" style="font-size: 1.8rem; letter-spacing: -0.5px;">@Model.FinalBalance.ToString("C")</h3>
                </div>

                <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="background-color: @(Model.FinalBalance >= 0 ? "#e6f4ea" : "#fce8e6"); width: 42px; height: 42px;">
                    <i class="bi @(Model.FinalBalance >= 0 ? "bi-pie-chart text-success" : "bi-exclamation-triangle text-danger") fs-4"></i>
                </div>
            </div>

            <div class="text-muted fs-7 pt-2 border-top border-light">
                <span>Resultado do período filtrado</span>
            </div>
        </div>
    </div>
</div>

@* Daily Transactions Table *@
<div class="card-glass mb-4">
    <div class="px-4 py-3 border-bottom border-light bg-light d-flex justify-content-between align-items-center">
        <span class="fw-bold fs-6 text-dark"><i class="bi bi-list-columns-reverse text-success me-2"></i>Movimentos Registrados (Ordem Cronológica)</span>

        <div class="input-group input-group-sm" style="max-width: 280px;">
            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control form-control-dark" placeholder="Buscar no histórico..." onkeyup="filterTransactionsTable(this)">
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover" id="tableTransactions">
            <thead>
                <tr>
                    <th>Data Mov.</th>
                    <th>Data Venc.</th>
                    <th>Histórico / Descrição</th>
                    <th>Categoria</th>
                    <th class="text-end">Valor</th>
                    <th class="text-center" style="width: 100px;">Ações</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.GridItems == null || !Model.GridItems.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Nenhum movimento registrado para este período.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.GridItems)
                    {
                        bool isCredit = item.Amount >= 0;

                        <tr class="align-middle" data-row-id="@item.Id">
                            <td class="text-nowrap fw-semibold">@(item.TransactionDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="text-nowrap text-muted">@(item.DueDate?.ToString("dd/MM/yyyy") ?? "-")</td>

                            <td>
                                <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                    @if (isCredit)
                                    {
                                        <i class="bi bi-arrow-down-left-circle-fill text-success" style="font-size: 1.1rem;"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-up-right-circle-fill text-danger" style="font-size: 1.1rem;"></i>
                                    }

                                    @item.Description
                                </div>
                            </td>

                            <td><span class="badge bg-light text-dark border">@item.CategoryName</span></td>

                            <td class="text-end fw-bolder @(isCredit ? "text-success" : "text-danger") fs-6">
                                @(isCredit ? "+" : "") @item.Amount.ToString("C")
                            </td>

                            <td class="text-center">
                                <button class="btn btn-sm btn-action-icon btn-action-edit" title="Editar linha" onclick="editTransactionRow(this, @item.Id)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-action-icon btn-action-delete" title="Excluir" onclick="deleteTransactionRow(this, @item.Id)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/transactions.js" asp-append-version="true"></script>
    <script src="~/js/categories.js" asp-append-version="true"></script>
}