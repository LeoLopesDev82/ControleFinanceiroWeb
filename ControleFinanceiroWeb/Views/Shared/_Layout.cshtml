@inject ControleFinanceiroWeb.Services.StatementType.IStatementTypeService StatementTypeService
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Controle Financeiro Web</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="app-container">
        @* Sidebar Backdrop for mobile *@
        <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar()"></div>

        @* Left Sidebar *@
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <a class="sidebar-brand d-flex align-items-center gap-2" asp-controller="Summary" asp-action="Index">
                    <div class="bg-white p-2 rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;">
                        <i class="bi bi-wallet2 text-success fs-5"></i>
                    </div>
                    <div>
                        <span class="fs-5 fw-bold text-white d-block lh-1">FinanControl</span>
                        <small class="text-white-50" style="font-size: 0.65rem; font-weight: 500; letter-spacing: 0.5px;">CONTROLE FINANCEIRO</small>
                    </div>
                </a>
            </div>

            <ul class="sidebar-menu" id="sidebarMenu">
                <li class="sidebar-item">
                    <a class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Summary" ? "active" : "")" asp-controller="Summary" asp-action="Index">
                        <i class="bi bi-bar-chart-line-fill text-white-50"></i> Resumo Geral
                    </a>
                </li>
                
                <li class="sidebar-item text-white-50 px-3 mt-4 mb-2 small text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.5px; font-weight: 600;">Extratos / Contas</li>
                
                @{
                    var tabs = await StatementTypeService.GetStatementTypesAsync();
                    var currentStatementType = Context.Request.Query["statementType"].ToString();
                    
                    bool isTransactionsController = ViewContext.RouteData.Values["Controller"]?.ToString() == "Transactions";
                    bool isExtratoActive = isTransactionsController && (string.IsNullOrEmpty(currentStatementType) || currentStatementType == "Extrato");
                }
                
                <li class="sidebar-item statement-dynamic-item position-relative">
                    <a class="sidebar-link @(isExtratoActive ? "active" : "")" href="/Transactions/Index?statementType=Extrato&statementTypeId=0" style="padding-right: 2.5rem;">
                        <i class="bi bi-file-earmark-text text-white-50"></i> Extrato
                    </a>
                </li>
                
                @foreach (var tab in tabs)
                {
                    bool isActive = isTransactionsController && currentStatementType == tab.Name;
                    
                    <li class="sidebar-item statement-dynamic-item position-relative">
                        <a class="sidebar-link @(isActive ? "active" : "")" href="/Transactions/Index?statementType=@(Uri.EscapeDataString(tab.Name ?? ""))&statementTypeId=@tab.Id" style="padding-right: 2.5rem;">
                            <i class="bi bi-credit-card text-white-50"></i> @tab.Name
                        </a>

                        <button class="btn btn-sm border-0 p-1 position-absolute end-0 top-50 translate-middle-y me-2 delete-statement-btn" 
                                onclick="deleteCustomStatementType(event, @tab.Id, '@(tab.Name?.Replace("'", "\\'"))')" 
                                title="Excluir Extrato" 
                                style="background: transparent; z-index: 5; color: @(isActive ? "rgba(0, 0, 0, 0.4)" : "rgba(255, 255, 255, 0.5)"); transition: color 0.2s;">
                            <i class="bi bi-x-lg" style="font-size: 0.75rem;"></i>
                        </button>
                    </li>
                }
                
                <li class="sidebar-item px-2 mt-3" id="btnAddExtratoContainer">
                    <button class="btn btn-add-extrato" onclick="openStatementTypeModal(0, '')" title="Cadastrar novo extrato">
                        <i class="bi bi-plus-lg"></i> Novo Extrato
                    </button>
                </li>
            </ul>

            <div class="sidebar-logout">
                <button type="button" class="sidebar-link border-0 bg-transparent w-100 text-start" onclick="document.getElementById('logoutForm').submit();">
                    <i class="bi bi-box-arrow-left text-white-50"></i> Sair
                </button>
            </div>

        </aside>

        @* Main Content Wrapper *@
        <div class="main-content">
            @* Mobile Header *@
            <header class="mobile-header">
                <button class="btn-sidebar-toggle" onclick="toggleSidebar()">
                    <i class="bi bi-list"></i>
                </button>

                <a class="mobile-brand" asp-controller="Summary" asp-action="Index">
                    <i class="bi bi-wallet2 me-2"></i> FinanControl
                </a>
                @* balance flex *@
            </header>

            <main role="main" class="container-fluid px-4 py-4 flex-grow-1 animate-fade-in">
                @RenderBody()
            </main>

            <footer class="border-top border-light py-4 text-muted mt-auto" style="background: #ffffff;">
                <div class="container-fluid px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span>&copy; 2026 <strong>FinanControl Web</strong> - Gestão Financeira Pessoal</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <partial name="_StatementTypeModal" />
    <partial name="_TransactionModal" />

    @* Category Management Modal *@
    @await Html.PartialAsync("_CategoryModal")

    @* Import Transactions Modal *@
    @await Html.PartialAsync("_ImportModal")

    @* Toast Notifications Container *@
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        <div id="actionToast" class="toast align-items-center text-dark bg-white border border-light shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2 fs-6 p-3" id="toastMessage">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i> Ação realizada com sucesso!
                </div>
        
                <button type="button" class="btn-close me-2 m-auto" data-bs-toast="dismiss"></button>
            </div>
        </div>
    </div>

    @* Custom MessageBox Modal (Bootstrap) *@
    <div class="modal fade" id="customMessageBoxModal" tabindex="-1" aria-hidden="true" style="z-index: 1200;">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content modal-content-glass">
                <div class="modal-header modal-header-custom bg-light py-2.5 px-3">
                    <h5 class="modal-title fw-bold text-dark fs-6" id="customMessageBoxTitle">Aviso</h5>
                    <button type="button" class="btn-close" aria-label="Close" id="customMessageBoxCloseBtn"></button>
                </div>
                
                <div class="modal-body p-4">
                    <p class="mb-0 text-muted fs-7" id="customMessageBoxMessage"></p>
                </div>
                
                <div class="modal-footer modal-footer-custom bg-light py-2 px-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-custom btn-sm py-1 px-3 fs-7" id="customMessageBoxNoBtn">Não</button>
                    <button type="button" class="btn btn-emerald btn-sm py-1 px-3 fs-7" id="customMessageBoxYesBtn">Sim</button>
                    <button type="button" class="btn btn-emerald btn-sm py-1 px-3 fs-7" id="customMessageBoxOkBtn">OK</button>
                </div>
            </div>
        </div>
    </div>

    <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/messagebox.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>