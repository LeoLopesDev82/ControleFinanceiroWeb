@model ControleFinanceiroWeb.Models.ViewModels.PinSetupViewModel
@{
    Layout = "_PinLayout";
    ViewData["Title"] = "Definir PIN";
}

<div class="pin-icon">
    <i class="bi bi-shield-plus"></i>
</div>

<h1 class="pin-title">Primeiro acesso</h1>
<p class="pin-subtitle">Escolha um PIN de 6 dígitos para proteger seus dados</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger py-2 px-3 text-center" role="alert">
        @Model.ErrorMessage
    </div>
}

<form asp-action="Setup" method="post" autocomplete="off">
    @Html.AntiForgeryToken()

    <label asp-for="Pin" class="form-label small text-muted">PIN</label>
    <input asp-for="Pin"
           class="form-control pin-input mb-2"
           type="password"
           inputmode="numeric"
           pattern="[0-9]*"
           maxlength="6"
           autocomplete="off"
           autofocus
           aria-label="Novo PIN" />
    <span asp-validation-for="Pin" class="text-danger d-block text-center small"></span>

    <label asp-for="ConfirmPin" class="form-label small text-muted mt-3">Confirme o PIN</label>
    <input asp-for="ConfirmPin"
           class="form-control pin-input"
           type="password"
           inputmode="numeric"
           pattern="[0-9]*"
           maxlength="6"
           autocomplete="off"
           aria-label="Confirmação do PIN" />
    <span asp-validation-for="ConfirmPin" class="text-danger d-block text-center small"></span>

    <button type="submit" class="btn btn-pin w-100 mt-3">
        <i class="bi bi-check-lg me-1"></i> Definir PIN
    </button>
</form>

<p class="pin-note">
    O PIN é gravado apenas como hash. Guarde-o: não há recuperação automática.
</p>

@section Scripts {
    <script src="~/js/pin.js" asp-append-version="true"></script>
}
